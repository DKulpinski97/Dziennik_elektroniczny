@model Dzienik_szkolny.ViewModels.DodajUzytkownikaViewModel

@{
    ViewData["Title"] = "Edycja użytkownika";
}

<div class="container mt-5">

    @if (TempData["Wiadomosc"] != null)
    {
        if (TempData["Wiadomosc"].ToString() == "Użytkownik dodany")
        {
            <div class="alert alert-success">
                @TempData["Wiadomosc"]
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                @TempData["Wiadomosc"]
            </div>
        }
    }
    <div class="row">

        <!-- Formularz użytkownika -->
        <div class="col-md-6 d-flex">
            <div class="border rounded p-4 w-100">

                <h3 class="text-center">Dodaj użytkownika</h3>

                @using (Html.BeginForm("DodajUzytkownika", "Admin", FormMethod.Post, new { id = "FormDodajUzytkownika" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <partial name="_FormulazDodajUzytkonika" model="Model" />

                    <button type="submit" class="btn btn-primary w-100 mt-3">
                        Dodaj użytkownika
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-3 w-100">
                        Powruć do porzedniego menu
                    </a>
                }

            </div>
        </div>


        <!-- Lista ról -->
        <div class="col-md-6 d-flex">
            <div class="border rounded p-4 w-100">

                <h3 class="text-center">Lista wszystkich ról</h3>
                @Html.ListBoxFor(x => x.IdRoli, new MultiSelectList(Model.Role, "Id", "Name"), new
                {
                    @class = "form-select",
                    size = 10,
                    id = "ListaRol",
                    form = "FormDodajUzytkownika"
                })

            </div>
        </div>

    </div>

</div>