@model Dziennik_szkolny.ViewModel.Uzytkownik.PrzywitanieUzytkownikaViewModel
<partial name="_Komunikat" />

<div class="container mt-5">
    <div class="container mt-4">
    <h2>Witaj, @Model.Imie @Model.Nazwisko!</h2>
    </div>
    <div class="row g-4" style="min-height: 75vh;">
        
        @if (new[] { NazwyRoli.SuperAdmin, NazwyRoli.Admin, NazwyRoli.Dyrektor}.Any(User.IsInRole))
        {
            <div class="col d-flex">
                <div class="border rounded p-4 w-100">
                    <h2 class="text-center">Panel administratora</h2>

                    @if (User.IsInRole(NazwyRoli.Admin))
                    {
                        @Html.ActionLink("Zarządzaj rolami", "KontrolerZarzadzajRolami", "Admin", null, new { @class = "btn btn-primary w-100 mb-3" })
                    }

                    @if (new[] { NazwyRoli.SuperAdmin, NazwyRoli.Admin, NazwyRoli.Dyrektor }.Any(User.IsInRole))
                    {
                        @Html.ActionLink("Zarządzaj użytkownikami", "ZarzadzajUzytkownikem", "Admin", null, new { @class = "btn btn-primary w-100 mb-3" })
                    }
                </div>
            </div>
        }
        else if (User.IsInRole(NazwyRoli.Sekretarka))
        {
            <div class="col d-flex">
                <div class="border rounded p-4 w-100">
                    <h2 class="text-center">Panel administratora</h2>
                    <p class="text-center text-muted">Panel jest obecnie pusty. W przyszłości zostaną dodane nowe funkcjonalności.</p>
                </div>
            </div>
        }
        @if (User.IsInRole(NazwyRoli.Nauczyciel) || User.IsInRole(NazwyRoli.Dyrektor))
        {
            <div class="col d-flex">
                <div class="border rounded p-4 w-100">
                    <h2 class="text-center">Panel nauczyciela</h2>
                    <p class="text-center text-muted">Panel jest obecnie pusty. W przyszłości zostaną dodane nowe funkcjonalności.</p>
                </div>
            </div>
        }
        @if (User.IsInRole(NazwyRoli.Rodzic))
        {
            <div class="col d-flex">
                <div class="border rounded p-4 w-100">
                    <h2 class="text-center">Panel rodzica</h2>
                    <p class="text-center text-muted">Panel jest obecnie pusty. W przyszłości zostaną dodane nowe funkcjonalności.</p>
                </div>
            </div>
        }
        <div class="col d-flex">
                <div class="border rounded p-4 w-100">
                    <h2 class="text-center">Panel informacji osobistych</h2>
                    <p class="text-center text-muted">Panel jest obecnie pusty. W przyszłości zostaną dodane nowe funkcjonalności.</p>
                </div>
            </div>
    </div>
</div>
