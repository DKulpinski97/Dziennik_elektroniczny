@{
    ViewData["Title"] = "Zarządzaj użytkownikami";
}

<div class="container mt-5">

    <h2 class="mb-4 text-center">
        Zarządzaj danymi użytkowników
    </h2>
    <partial name="_Komunikat" />

    <div class="row g-4">
        <!-- Panel edycji -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-warning">
                    Operacje
                </div>


                <div class="card-body">

                    <p>
                        Wybierz użytkownika z jednej z list,
                        aby rozpocząć edycję lub usuwanie użytkownika.
                    </p>

                    @using (Html.BeginForm("DodajUzytkownika", "Admin", FormMethod.Get))
                    {
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            Dodaj użytkownika
                        </button>
                    }

                    @using (Html.BeginForm("PrzygotujUzytkownikaDoEdycji", "Admin", FormMethod.Get))
                    {
                        @Html.Hidden("IdUzytkownika", null, new { id = "EdytujId" })

                        <button type="submit" id="btnEdytujUzytkownika" class="btn btn-primary w-100 mb-2" disabled>
                            Edytuj dane
                        </button>
                    }


                    @using (Html.BeginForm("UsunUzytkownika", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden("IdUzytkownika", null, new { id = "UsunId" })

                        <button type="submit" id="btnUsunUzytkownika" class="btn btn-danger w-100" disabled onclick="return confirm('Czy na pewno chcesz usunąć użytkownika: ' + wybranyUzytkownik + '?');">
                            Usuń użytkownika
                        </button>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-3 w-100">
                        Powróć do poprzedniego menu
                    </a>

                </div>

            </div>

        </div>
        <!-- Rodzice  -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    Rodzice
                </div>

                <!-- ViewBag zamiast VievModel bo to projekt pokazowy i nie ma potrzeby nadmiernie komplikować systemu  -->
                <div class="card-body">
                    @if (ViewBag.Rodzice != null && ViewBag.Rodzice.Count > 0)
                    {
                        <select class="form-select" id="Rodzice" name="RodzicId" size="12">
                            @foreach (var rodzic in ViewBag.Rodzice)
                            {
                                <option value="@rodzic.Value">
                                    @rodzic.Text
                                </option>
                            }

                        </select>
                    }
                    else
                    {
                        <p class="text-muted">Brak rodziców w systemie.</p>
                    }

                </div>

            </div>

        </div>



        <!-- Pracownicy -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">
                    Pracownicy
                </div>

                 <!-- ViewBag zamiast VievModel bo to projekt pokazowy i nie ma potrzeby nadmiernie komplikować systemu  -->
                <div class="card-body">
                    @if (ViewBag.Pracownicy != null && ViewBag.Pracownicy.Count > 0)
                    {
                        <select class="form-select" id="Pracownicy" name="PracownikId" size="12">
                            @foreach (var pracownik in ViewBag.Pracownicy)
                            {
                                <option value="@pracownik.Value">
                                    @pracownik.Text
                                </option>
                            }

                        </select>

                    }
                    else
                    {
                        <p class="text-muted">Brak pracowników w systemie.</p>
                    }
                </div>

            </div>

        </div>
    </div>
</div>
<script>
  let wybranyUzytkownik = "";

const rodzice = document.getElementById("Rodzice");
const pracownicy = document.getElementById("Pracownicy");

const edytujId = document.getElementById("EdytujId");
const usunId = document.getElementById("UsunId");

const btnEdytuj = document.getElementById("btnEdytujUzytkownika");
const btnUsun = document.getElementById("btnUsunUzytkownika");

function ustawIdUzytkownika(lista, drugaLista) {
    const id = lista.value;

    if (!id) {
        wybranyUzytkownik = "";
        edytujId.value = "";
        usunId.value = "";

        btnEdytuj.disabled = true;
        btnUsun.disabled = true;

        return;
    }

    const option = lista.options[lista.selectedIndex];

    wybranyUzytkownik = option.text.trim();

    edytujId.value = id;
    usunId.value = id;

    if (drugaLista) {
        drugaLista.selectedIndex = -1;
    }

    btnEdytuj.disabled = false;
    btnUsun.disabled = false;
}

if (rodzice) {
    rodzice.addEventListener("change", function () {
        ustawIdUzytkownika(rodzice, pracownicy);
    });
}

if (pracownicy) {
    pracownicy.addEventListener("change", function () {
        ustawIdUzytkownika(pracownicy, rodzice);
    });
}
</script>
