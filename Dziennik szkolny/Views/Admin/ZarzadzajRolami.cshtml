@model List<Dziennik_szkolny.Application.ObiektyTransferuDanych.DaneRoli>

@{
    ViewData["Title"] = "Zarządzanie rolami";
}

<div class="container mt-5">
    <div class="row g-4" style="min-height: 75vh;">

        <div class="col d-flex">
            <div class="border rounded p-4 w-100">

                <h2 class="text-center">Menu dodawania roli</h2>

                <partial name="_Komunikat" />


                @using (Html.BeginForm("DodajRole", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.TextBox("NazwaRoli", "", new { @class = "form-control", id = "NazwaRoli", placeholder = "np. Nauczyciel", maxlength = Dziennik_szkolny.Domain.OgraniczeniaNazwyRoli.MaksymalnaDlugosc })
                    <small class="text-muted">@Dziennik_szkolny.Domain.OgraniczeniaNazwyRoli.KomunikatBledu</small>
                    <br />
                    <small class="text-muted">@Dziennik_szkolny.Domain.OgraniczeniaNazwyRoli.Podpowiedz</small>


                    <button type="submit" class="btn btn-warning mt-3 w-100">
                        Dodaj rolę
                    </button>
                }



                <hr />

                <h2 class="text-center">Zmiana nazwy roli</h2>

                <p>
                    Wybierz rolę z listy po prawej,
                    aby zmienić jej nazwę lub ją usunąć.
                </p>

                @using (Html.BeginForm("ZmienNazweRoli", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.Hidden("StaraNazwaRoli", "", new { id = "StaraNazwaRoli" })

                    @Html.TextBox("NowaNazwaRoli", "", new { @class = "form-control", id = "NowaNazwaRoli", placeholder = "Nowa nazwa roli", maxlength = Dziennik_szkolny.Domain.OgraniczeniaNazwyRoli.MaksymalnaDlugosc })
                    <small class="text-muted">@Dziennik_szkolny.Domain.OgraniczeniaNazwyRoli.KomunikatBledu</small>
                    <br />
                    <small class="text-muted">@Dziennik_szkolny.Domain.OgraniczeniaNazwyRoli.Podpowiedz</small>

                    @Html.Hidden("RoleId", "", new { id = "RoleIdZmiana" })

                    <button type="submit" id="btnEdytujRole" class="btn btn-warning mt-3 w-100" disabled>
                        Zmień nazwę
                    </button>
                }



                <h2 class="text-center mt-4">Usuń</h2>


                @using (Html.BeginForm("UsunRole", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <label id="NazwaDoUsuniecia">
                        Brak wybranej roli
                    </label>
                    <br />
                    @Html.Hidden("RoleId", "", new { id = "RoleIdUsun" })

                    <button type="submit" id="btnUsunRole" class="btn btn-warning mt-3 w-100" disabled onclick="return confirm('Czy na pewno chcesz usunąć rolę: ' + document.getElementById('NazwaDoUsuniecia').textContent.trim() + '?');">
                        Usuń
                    </button>

                }
                <a asp-controller="Admin" asp-action="KontrolerZarzadzajRolami" class="btn btn-warning mt-3 w-100">
                    Powrót do poprzedniego menu
                </a>
            </div>
        </div>



        <div class="col d-flex">
            <div class="border rounded p-4 w-100">

                <h2 class="text-center">
                    Lista ról poza systemowych
                </h2>
                @Html.DropDownList("RoleList", new SelectList(Model, "Id", "Nazwa", (string)ViewBag.RolaId), new { @class = "form-select", size = 10, id = "ListaRol" })

                
            </div>
        </div>

    </div>
</div>



<script>
    const listaRol = document.getElementById("ListaRol");
    const btnEdytuj = document.getElementById("btnEdytujRole");
    const btnUsun = document.getElementById("btnUsunRole");

    function AktualizujPrzyciski(event) {
        let wybranaOpcja = listaRol.options[listaRol.selectedIndex];

        if (!wybranaOpcja || !wybranaOpcja.value) {
            btnEdytuj.disabled = true;
            btnUsun.disabled = true;
            return;
        }

        btnEdytuj.disabled = false;
        btnUsun.disabled = false;

        let nazwaRoli = wybranaOpcja.text;
        let idRoli = wybranaOpcja.value;

        document.getElementById("NazwaDoUsuniecia").textContent = nazwaRoli;
        document.getElementById("StaraNazwaRoli").value = nazwaRoli;

        if (event?.isTrusted) {
            document.getElementById("NowaNazwaRoli").value = nazwaRoli;
        }

        document.getElementById("RoleIdZmiana").value = idRoli;
        document.getElementById("RoleIdUsun").value = idRoli;
    }

    listaRol.addEventListener("change", AktualizujPrzyciski);

    // Inicjalizacja przycisków i pól po załadowaniu widoku
    AktualizujPrzyciski();

</script>