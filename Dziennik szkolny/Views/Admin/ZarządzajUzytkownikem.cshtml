@{
    ViewData["Title"] = "Zarządzaj użytkownikami";
}

<div class="container mt-5">

    <h2 class="mb-4 text-center">
        Zarządzaj danymi użytkowników
    </h2>
    @if (TempData["Wiadomosc"] != null)
    {
        <div class="alert alert-@TempData["TypWiadomosci"]">
            @TempData["Wiadomosc"]
        </div>
    }

    <div class="row g-4">
        <!-- Panel edycji -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-warning">
                    Operacje
                </div>


                <div class="card-body">

                    <p>
                        Wybierz użytkownika z jednej z list,
                        aby rozpocząć edycję lub usuwanie użytkownika.
                    </p>

                    @using (Html.BeginForm("DodajUzytkownika", "Admin", FormMethod.Get))
                    {
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            Dodaj użytkownika
                        </button>
                    }

                    @using (Html.BeginForm("PrzygotujUzytkownikaDoEdycji", "Admin", FormMethod.Get))
                    {
                        @Html.Hidden("IdUzytkownika", null, new { id = "EdytujId" })

                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            Edytuj dane
                        </button>
                    }


                    @using (Html.BeginForm("UsunUzytkownika", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden("IdUzytkownika", null, new { id = "UsunId" })

                        <button type="submit"class="btn btn-danger w-100"onclick="return confirm('Czy na pewno chcesz usunąć użytkownika: ' + wybranyUzytkownik + '?');">
                            Usuń użytkownika
                        </button>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-3 w-100">
                        Powróć do poprzedniego menu
                    </a>

                </div>

            </div>

        </div>
        <!-- Rodzice  -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    Rodzice
                </div>

                <div class="card-body">

                    <select class="form-select"
                            id="Rodzice"
                            name="RodzicId"
                            size="12">
                        <!-- ViewBag zamiast VievModel bo to projekt pokazowy i nie ma potrzeby nadmiernie komplikować systemu  -->
                        @foreach (var rodzic in ViewBag.Rodzice)
                        {
                            <option value="@rodzic.Value">
                                @rodzic.Text
                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>



        <!-- Pracownicy -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">
                    Pracownicy
                </div>

                <div class="card-body">

                    <select class="form-select"
                            id="Pracownicy"
                            name="PracownikId"
                            size="12">
                        <!-- ViewBag zamiast VievModel bo to projekt pokazowy i nie ma potrzeby nadmiernie komplikować systemu  -->
                        @foreach (var pracownik in ViewBag.Pracownicy)
                        {
                            <option value="@pracownik.Value">
                                @pracownik.Text
                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>
    </div>

</div>
<script>

    let wybranyUzytkownik = "";


    function ustawIdUzytkownika(id, nazwa) {
        wybranyUzytkownik = nazwa;
        document.getElementById("EdytujId").value = id;
        document.getElementById("UsunId").value = id;
    }


    document.getElementById("Rodzice")
        .addEventListener("change", function() {

            let option = this.options[this.selectedIndex];

            ustawIdUzytkownika(
                this.value,
                option.text
            );

            document.getElementById("Pracownicy").selectedIndex = -1;
        });


    document.getElementById("Pracownicy")
        .addEventListener("change", function() {

            let option = this.options[this.selectedIndex];

            ustawIdUzytkownika(
                this.value,
                option.text
            );

            document.getElementById("Rodzice").selectedIndex = -1;
        });


</script>