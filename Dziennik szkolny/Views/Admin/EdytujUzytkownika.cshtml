@model Dziennik_szkolny.ViewModel.EdytujUzytkownikaViewModel

@{
    ViewData["Title"] = "Edytuj dane użytkownika";
}

<div class="container mt-5">

    @if (TempData["Wiadomosc"] != null)
    {
        <div class="alert alert-@TempData["TypWiadomosci"]">
            @TempData["Wiadomosc"]
        </div>
    }
    <div class="row">

        <!-- Formularz użytkownika -->
        <div class="col-md-6 d-flex">
            <div class="border rounded p-4 w-100">

                <h3 class="text-center">Edytuj dane użytkownika</h3>

                @using (Html.BeginForm("EdytujDaneUzytkownika", "Admin", FormMethod.Post, new { id = "FormEdytujUzytkownika" }))
                {
                    <div class="mb-3">
                        @Html.LabelFor(x => x.Haslo, new { @class = "form-label" })
                        @Html.PasswordFor(x => x.Haslo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(x => x.Haslo, "", new { @class = "text-danger" })
                    </div>
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.IdUzytkownika)
                    <partial name="_FormularzZarzadzajUzytkownika" model="Model" />

                    <button type="submit" class="btn btn-primary w-100 mt-3">
                        Zapisz zmiany
                    </button>
                    @Html.ActionLink("Powróć do poprzedniego menu", "ZarzadzajUzytkownikem", "Admin", null, new { @class = "btn btn-primary w-100 mb-3" })
                }

            </div>
        </div>


        <!-- Lista ról -->
        <div class="col-md-6 d-flex">
            <div class="border rounded p-4 w-100">

                <h3 class="text-center">Lista wszystkich ról</h3>
                @Html.ValidationMessageFor(x => x.WybraneRole, "", new { @class = "text-danger" })
                @Html.ListBoxFor(
                    x => x.WybraneRole,
                    Model.DostepneRole,
                    new
                    {
                        @class = "form-select",
                        size = 10,
                        id = "ListaRol",
                        form = "FormEdytujUzytkownika"
                    })

            </div>
        </div>

    </div>

</div>


