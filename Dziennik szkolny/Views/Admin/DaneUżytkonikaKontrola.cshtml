@model Dziennik_szkolny.ViewModel.UzytkownikaViewModel

@{
    ViewData["Title"] = "Zarządzaj danymi użytkownika";
}

<div class="container mt-5">

    @if (TempData["Wiadomosc"] != null)
    {
        <div class="alert alert-@TempData["TypWiadomosci"]">
            @TempData["Wiadomosc"]
        </div>
    }
    <div class="row">

        <!-- Formularz użytkownika -->
        <div class="col-md-6 d-flex">
            <div class="border rounded p-4 w-100">

                <h3 class="text-center">Dodaj użytkownika</h3>

                @using (Html.BeginForm(ViewBag.TrybDodawania == true ? "DodajUzytkownika" : "EdytujDaneUzytkownika", "Admin", FormMethod.Post, new { id = "FormDodajUzytkownika" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    @Html.HiddenFor(x => x.IdDanych)
                    @Html.HiddenFor(x => x.idUzytkownika)
                    <partial name="_FormulazDodajUzytkonika" model="Model" />
                    @if (ViewBag.TrybDodawania == true)
                    {
                        <button type="submit" class="btn btn-warning w-100 mt-3">
                            Dodaj użytkownika
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary w-100 mt-3">
                            Zapisz zmiany
                        </button>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-3 w-100">
                        Powróć do poprzedniego menu
                    </a>
                }

            </div>
        </div>


        <!-- Lista ról -->
        <div class="col-md-6 d-flex">
            <div class="border rounded p-4 w-100">

                <h3 class="text-center">Lista wszystkich ról</h3>

                @Html.ListBoxFor(
                    x => x.WybraneRole,
                    Model.DostepneRole,
                    new
                    {
                        @class = "form-select",
                        size = 10,
                        id = "ListaRol",
                        form = "FormDodajUzytkownika"
                    })

            </div>
        </div>

    </div>

</div>


